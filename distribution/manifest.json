{
  "schemaVersion": 1,
  "platformId": "ai-dev-platform",
  "version": "1.5.1",
  "archiveRoot": "ai-dev-platform",
  "archiveName": "ai-dev-platform-{version}.zip",
  "include": [
    ".editorconfig",
    ".gitattributes",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "opencode.json",
    "adapters",
    "distribution",
    "docs",
    "examples",
    "governance",
    "profiles",
    "registry",
    "scripts",
    "templates",
    "tests",
    "workflow"
  ],
  "excludeNames": [
    ".DS_Store",
    ".git",
    "__pycache__"
  ],
  "excludeGlobs": [
    "examples/**/build/**",
    "examples/**/dist/**",
    "examples/android-app/.gradle/**",
    "examples/android-app/local.properties"
  ]
}
